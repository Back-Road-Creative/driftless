# Template for the SOPS-encrypted secrets overlay. Copy this to a working file,
# fill in real values, and encrypt it in place with SOPS:
#
#     cp deploy/secrets.env.example deploy/secrets.enc.env
#     sops-edit deploy/secrets.enc.env      # or: sops -e -i deploy/secrets.enc.env
#
# The encrypted deploy/secrets.enc.env is the only one committed or mounted; this
# plaintext template is public, so every key below ships with NO value at all: a
# value written here would be a published constant, and one copied through unedited
# would authorize anyone who has read this repository. Empty is what makes that
# impossible — deploy/entrypoint.sh already refuses to start on an empty value, so
# a copy of this file that nobody edited cannot serve a single request. Give each
# key a long random value of its own, e.g. `openssl rand -hex 32`.

# The database password. Also export it into your shell before `docker compose
# up` so Compose can substitute it into the driftless-db service (see OPERATIONS.md).
POSTGRES_PASSWORD=

# The bearer token every API request must present (except /health and /static).
DRIFTLESS_API_TOKEN=

# The key that signs session cookies. Without it no cookie can authorize, so no
# one can sign in through a browser; the container refuses to start rather than
# serve a deployment with no way in. Changing it signs every open session out.
DRIFTLESS_SESSION_SECRET=
